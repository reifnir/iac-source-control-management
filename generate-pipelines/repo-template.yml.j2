# Generated by generate_pipeline.py from repos.yaml. Do not edit by hand.
workflow:
  rules:
    - if: $CI_MERGE_REQUEST_ID
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

stages:
  - projects

variables:
  TF_VAR_github_admin_token: $GITHUB_ADMIN_TOKEN
  TF_VAR_gitlab_token: $GITLAB_AUTOMATION_TOKEN

{% for project in projects %}

{{ project.full_project_path | tojson }}:
  resource_group: {{ project.full_project_path | tojson }}
  stage: projects
  trigger:
    include:
      - project: reifnir-public-projects/iac/job-templates
        ref: main
        file: /gitlab/terraform-pipeline-default.yaml
    strategy: depend
  variables:
    ALREADY_SCANNED: "true" # Scanned in parent pipeline
    TF_VAR_gitlab_parent_group_path: {{ project.group_path | tojson }}
    TF_VAR_gitlab_project_name: {{ project.project_name | tojson }}
    TF_VAR_project_description: {{ project.description | tojson }}
    TERRAFORM_STATE_KEY: {{ project.state_key | tojson }}
{% endfor %}
